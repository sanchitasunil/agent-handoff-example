# --- LiveKit server connection ---
LIVEKIT_URL=                # Your LiveKit server/Cloud WebSocket URL, e.g. wss://your-project.livekit.cloud
LIVEKIT_API_KEY=            # LiveKit API key (from LiveKit Cloud dashboard or your self-hosted server config)
LIVEKIT_API_SECRET=         # LiveKit API secret (paired with the key above)

# --- STT provider (Deepgram, used in agent.py) ---
DEEPGRAM_API_KEY=           # Deepgram API key for speech-to-text (deepgram.STT)

# --- LLM provider (OpenAI, used in agent.py) ---
OPENAI_API_KEY=             # OpenAI API key for the language model (openai.LLM)

# --- TTS provider (Murf, used in agent.py) ---
MURF_API_KEY=               # Murf API key for text-to-speech (murf.TTS). Get one at murf.ai under API settings.

# --- Escalation notifications (escalations/notify.py) ---
ESCALATION_SINK=console     # Where escalation alerts get sent: "console" (print to stdout, zero setup, default) | "webhook" (POST JSON to ESCALATION_WEBHOOK_URL below) | "none" (disable notifications entirely). The escalation itself is always saved to the store regardless of this setting.
ESCALATION_WEBHOOK_URL=     # Only used when ESCALATION_SINK=webhook. Any URL that accepts a JSON POST body works. To get one: Discord — channel Settings → Integrations → Webhooks → New Webhook → Copy URL; Slack — api.slack.com/apps → your app → Incoming Webhooks → Add New Webhook to Workspace; a help desk (Zendesk, Freshdesk, etc.) — its inbound webhook/API endpoint. Discord/Slack expect a specific JSON shape ({"content": "..."}) rather than the raw escalation object — see the worked example in notify.py's module docstring.
